import pygame
import random
import sys

# Inisialisasi Pygame
pygame.init()
pygame.mixer.init()

# Konfigurasi Layar
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Cyber Breaker - Kompetisi Python Game")

# Palet Warna (Tema Cyber/Neon)
BLACK = (10, 10, 20)
WHITE = (255, 255, 255)
NEON_BLUE = (0, 243, 255)
NEON_PINK = (255, 0, 127)
NEON_GREEN = (57, 255, 20)
YELLOW = (255, 255, 0)
GRAY = (100, 100, 100)

# Pengaturan Font
font_title = pygame.font.SysFont("Arial", 50, bold=True)
font_main = pygame.font.SysFont("Arial", 24)
font_small = pygame.font.SysFont("Arial", 18)

class Paddle:
    def __init__(self):
        self.width = 120
        self.height = 15
        self.x = SCREEN_WIDTH // 2 - self.width // 2
        self.y = SCREEN_HEIGHT - 40
        self.speed = 8
        self.rect = pygame.Rect(self.x, self.y, self.width, self.height)

    def move(self, keys):
        if keys[pygame.K_LEFT] or keys[pygame.K_a]:
            self.x -= self.speed
        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:
            self.x += self.speed

        # Batas layar
        if self.x < 0:
            self.x = 0
        if self.x > SCREEN_WIDTH - self.width:
            self.x = SCREEN_WIDTH - self.width
            
        self.rect.x = self.x

    def draw(self, surface):
        pygame.draw.rect(surface, NEON_BLUE, self.rect, border_radius=8)


class Ball:
    def __init__(self):
        self.radius = 8
        self.reset()

    def reset(self):
        self.x = SCREEN_WIDTH // 2
        self.y = SCREEN_HEIGHT // 2
        self.speed_x = random.choice([-4, 4])
        self.speed_y = -5
        self.rect = pygame.Rect(self.x - self.radius, self.y - self.radius, self.radius * 2, self.radius * 2)

    def move(self):
        self.x += self.speed_x
        self.y += self.speed_y
        self.rect.x = self.x - self.radius
        self.rect.y = self.y - self.radius

        # Pantulan dinding kiri/kanan
        if self.x - self.radius <= 0 or self.x + self.radius >= SCREEN_WIDTH:
            self.speed_x *= -1

        # Pantulan dinding atas
        if self.y - self.radius <= 0:
            self.speed_y *= -1

    def draw(self, surface):
        pygame.draw.circle(surface, NEON_PINK, (int(self.x), int(self.y)), self.radius)


class Brick:
    def __init__(self, x, y, width, height, color, points):
        self.rect = pygame.Rect(x, y, width, height)
        self.color = color
        self.points = points
        self.alive = True

    def draw(self, surface):
        if self.alive:
            pygame.draw.rect(surface, self.color, self.rect, border_radius=4)
            pygame.draw.rect(surface, WHITE, self.rect, 1, border_radius=4)


class Game:
    def __init__(self):
        self.clock = pygame.time.Clock()
        self.state = "MENU"
        self.score = 0
        self.lives = 3
        
        self.paddle = Paddle()
        self.ball = Ball()
        self.bricks = []
        self.create_bricks()

    def create_bricks(self):
        self.bricks = []
        rows = 5
        cols = 10
        brick_width = 70
        brick_height = 25
        padding = 10
        offset_x = 35
        offset_y = 60

        colors = [NEON_PINK, YELLOW, NEON_GREEN, NEON_BLUE, WHITE]
        
        for r in range(rows):
            for c in range(cols):
                bx = offset_x + c * (brick_width + padding)
                by = offset_y + r * (brick_height + padding)
                points = (rows - r) * 10
                color = colors[r % len(colors)]
                self.bricks.append(Brick(bx, by, brick_width, brick_height, color, points))

    def reset_game(self):
        self.score = 0
        self.lives = 3
        self.ball.reset()
        self.create_bricks()

    def run(self):
        while True:
            self.handle_events()
            self.update()
            self.draw()
            self.clock.tick(60)

    def handle_events(self):
        events = pygame.event.get()
        for event in events:
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            if event.type == pygame.KEYDOWN:
                if self.state == "MENU":
                    if event.key == pygame.K_RETURN:
                        self.state = "PLAYING"
                elif self.state == "GAMEOVER" or self.state == "WIN":
                    if event.key == pygame.K_r:
                        self.reset_game()
                        self.state = "PLAYING"
                    elif event.key == pygame.K_m:
                        self.state = "MENU"

    def update(self):
        if self.state == "PLAYING":
            keys = pygame.key.get_pressed()
            self.paddle.move(keys)
            self.ball.move()

            if self.ball.y > SCREEN_HEIGHT:
                self.lives -= 1
                if self.lives <= 0:
                    self.state = "GAMEOVER"
                else:
                    self.ball.reset()

            if self.ball.rect.colliderect(self.paddle.rect):
                self.ball.speed_y *= -1
                offset = self.ball.x - (self.paddle.x + self.paddle.width / 2)
                self.ball.speed_x = offset * 0.15

            for brick in self.bricks:
                if brick.alive and self.ball.rect.colliderect(brick.rect):
                    brick.alive = False
                    self.score += brick.points
                    self.ball.speed_y *= -1
                    
                    if all(not b.alive for b in self.bricks):
                        self.state = "WIN"
                    break

    def draw(self):
        screen.fill(BLACK)

        if self.state == "MENU":
            title_surf = font_title.render("CYBER BREAKER", True, NEON_BLUE)
            start_surf = font_main.render("Tekan [ENTER] untuk Memulai", True, WHITE)
            controls_surf = font_small.render("Gunakan Tombol Panah Kiri/Kanan atau A/D untuk bergerak", True, GRAY)

            screen.blit(title_surf, (SCREEN_WIDTH // 2 - title_surf.get_width() // 2, 200))
            screen.blit(start_surf, (SCREEN_WIDTH // 2 - start_surf.get_width() // 2, 300))
            screen.blit(controls_surf, (SCREEN_WIDTH // 2 - controls_surf.get_width() // 2, 360))

        elif self.state == "PLAYING":
            self.paddle.draw(screen)
            self.ball.draw(screen)
            for brick in self.bricks:
                brick.draw(screen)

            score_text = font_main.render(f"Skor: {self.score}", True, WHITE)
            lives_text = font_main.render(f"Nyawa: {self.lives}", True, NEON_PINK)
            screen.blit(score_text, (20, 15))
            screen.blit(lives_text, (SCREEN_WIDTH - 120, 15))

        elif self.state == "GAMEOVER":
            over_text = font_title.render("GAME OVER", True, NEON_PINK)
            final_score = font_main.render(f"Skor Akhir Anda: {self.score}", True, WHITE)
            restart_text = font_main.render("Tekan [R] untuk Main Lagi | [M] untuk Menu", True, GRAY)

            screen.blit(over_text, (SCREEN_WIDTH // 2 - over_text.get_width() // 2, 200))
            screen.blit(final_score, (SCREEN_WIDTH // 2 - final_score.get_width() // 2, 280))
            screen.blit(restart_text, (SCREEN_WIDTH // 2 - restart_text.get_width() // 2, 340))

        elif self.state == "WIN":
            win_text = font_title.render("ANDA MENANG! 🎉", True, NEON_GREEN)
            final_score = font_main.render(f"Total Skor: {self.score}", True, WHITE)
            restart_text = font_main.render("Tekan [R] untuk Main Lagi | [M] untuk Menu", True, GRAY)

            screen.blit(win_text, (SCREEN_WIDTH // 2 - win_text.get_width() // 2, 200))
            screen.blit(final_score, (SCREEN_WIDTH // 2 - final_score.get_width() // 2, 280))
            screen.blit(restart_text, (SCREEN_WIDTH // 2 - restart_text.get_width() // 2, 340))

        pygame.display.flip()

if __name__ == "__main__":
    game = Game()
    game.run()
